# Connection string de Supabase (Settings > Database > Connection string > "Transaction pooler")
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Puerto del backend
PORT=3001

# Origen permitido para CORS (el front de Next.js)
FRONTEND_ORIGIN="http://localhost:3000"

# --- Proveedor de IA ---
# "google" (Gemini 3.1 Flash-Lite, recomendado) o "anthropic" (Claude Haiku 4.5) como respaldo
AI_PROVIDER="google"

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=""
# Confirmar el ID exacto del modelo en la consola de Google antes de producción
# (los modelos "preview" cambian de nombre; este es el esperado a agosto 2026)
GOOGLE_MODEL_ID="gemini-3.1-flash-lite"

# --- RAG ---
# El indice usa embeddings Google aun cuando AI_PROVIDER sea "anthropic".
# Cambiar modelo o dimension requiere reindexar todos los materiales.
RAG_EMBEDDING_MODEL_ID="gemini-embedding-001"
RAG_EMBEDDING_DIMENSIONS="768"

# Clave de Anthropic (solo si AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_ID="claude-haiku-4-5"

# --- Autenticación de docentes: Supabase Auth ---
# Proyecto de Supabase que emite los logins (el registro, el login y "olvidé mi contraseña" los hace Supabase desde el front).
# El backend verifica los tokens contra las claves públicas (JWKS) del proyecto: no necesita ningún secreto.
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
# Solo si el proyecto todavía usa el secreto compartido legado (Project Settings > JWT Keys > Legacy JWT Secret), o en tests.
# Si se define, los tokens HS256 se verifican con él; si no, se rechazan siempre.
# SUPABASE_JWT_SECRET=""

# --- Token del alumno ---
# Firma SOLO el token del intento de un alumno al rendir (no el de los docentes).
# Secreto de mínimo 32 caracteres, el backend no arranca sin él. Generar uno con: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="12h"
