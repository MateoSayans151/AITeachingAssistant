# Connection string de Supabase. Lo más seguro es copiarla tal cual de Settings > Database > Connection string
# (pestaña "Transaction pooler") y reemplazar solo la contraseña. El formato real es:
#   - usuario: postgres.PROJECT_REF   (NO "postgres" a secas: si no, el pooler responde "no tenant identifier provided")
#   - host:    aws-0-REGION.pooler.supabase.com   (la región es la de tu proyecto, ej. sa-east-1)
#   - puerto:  6543 (Transaction pooler), con ?pgbouncer=true
#   - contraseña: URL-encoded si tiene caracteres especiales (@ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23)
#   - SIN corchetes: PROJECT_REF, PASSWORD_URL_ENCODED y REGION son solo "completar acá". Si dejás corchetes [ ] en el
#     host, Prisma lo lee como una dirección IPv6 y falla con "invalid IPv6 address".
# Ejemplo (ficticio):
#   postgresql://postgres.abcdefghijklmnop:mi%40clave@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Para correr `npx prisma db push` / `prisma migrate` (siempre parado en backend/) el Transaction pooler (6543) puede
# quedarse colgado. Usá el Session pooler: mismo usuario y host, pero puerto 5432 y SIN ?pgbouncer=true:
#   postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres
# Cambiá DATABASE_URL a esa URL solo mientras corrés el comando y después volvé a la de 6543.
# (Todavía no hay DIRECT_URL / directUrl en schema.prisma; ver MEJORAS.md, puntos 2 y 3.)

# Puerto del backend
PORT=3001

# Origen permitido para CORS (el front de Next.js)
FRONTEND_ORIGIN="http://localhost:3000"

# --- Proveedor de IA ---
# "google" (Gemini 3.1 Flash-Lite, recomendado) o "anthropic" (Claude Haiku 4.5) como respaldo
AI_PROVIDER="google"

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=""
# ID verificado contra la doc oficial de Gemini (ai.google.dev/gemini-api/docs/models) el 2026-10-04: "gemini-3.1-flash-lite"
# figura como modelo estable. OJO: la variante "gemini-3.1-flash-lite-preview" ya está dada de baja, no usarla.
# Si algún día Google lo reemplaza, volvé a chequear ese listado antes de cambiarlo.
GOOGLE_MODEL_ID="gemini-3.1-flash-lite"

# --- RAG ---
# El indice usa embeddings Google aun cuando AI_PROVIDER sea "anthropic".
# "gemini-embedding-001" figura como modelo estable en la doc oficial (verificado el 2026-10-04) y soporta 768 dimensiones.
# Cambiar modelo o dimension requiere reindexar todos los materiales.
RAG_EMBEDDING_MODEL_ID="gemini-embedding-001"
RAG_EMBEDDING_DIMENSIONS="768"

# Clave de Anthropic (solo si AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_ID="claude-haiku-4-5"

# --- Autenticación de docentes: Supabase Auth ---
# Proyecto de Supabase que emite los logins (el registro, el login y "olvidé mi contraseña" los hace Supabase desde el front).
# El backend verifica los tokens contra las claves públicas (JWKS) del proyecto: no necesita ningún secreto.
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
# Solo si el proyecto todavía usa el secreto compartido legado (Project Settings > JWT Keys > Legacy JWT Secret), o en tests.
# Si se define, los tokens HS256 se verifican con él; si no, se rechazan siempre.
# SUPABASE_JWT_SECRET=""

# --- Token del alumno ---
# Firma SOLO el token del intento de un alumno al rendir (no el de los docentes).
# Secreto de mínimo 32 caracteres, el backend no arranca sin él. Generar uno con: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# --- Corrección con IA ---
# Máximo de correcciones simultáneas contra el LLM y los embeddings (protege la cuota cuando entrega todo el curso a la vez).
IA_MAX_CONCURRENTES="4"
